# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored; this example is committed so teammates know what to set.

# Paths are relative to the project root.
DATA_DIR_RAW=data/raw
DATA_DIR_PROCESSED=data/processed
MODEL_DIR=model
REPORTS_DIR=reports
DOCS_DIR=docs

# Reproducibility seed used across data generation and resampling.
RANDOM_SEED=42
